# Canonical public origin. Use the final HTTPS domain in Production.
SITE_URL=https://picvisual.com
# Optional compatibility alias; SITE_URL takes precedence.
NEXT_PUBLIC_SITE_URL=

# Local development database. Production must use Neon with SSL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/picvisual?schema=public
# Local release QA only. Set to 1 to verify the public fallback without a database.
PICVISUAL_DATABASE_DISABLED=
# Optional read-only production infrastructure check. Set to 1 only in a controlled release check.
PICVISUAL_VERIFY_INFRA=
# At least 32 random characters; keep private and distinct by environment.
AUTH_SECRET=
# Intentional first-owner bootstrap only (not consumed at application startup).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# QA tooling only: development, test, qa, or staging. Never infer this value.
CLOUDINARY_ENVIRONMENT=
