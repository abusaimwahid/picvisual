# Public URL used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-side alias for integrations that expect SITE_URL.
SITE_URL=http://localhost:3000

# PostgreSQL only. Use a separate database for local development.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/picvisual?schema=public

# Generate a long random value (for example: openssl rand -base64 32).
AUTH_SECRET=

# Used only by the intentional db:seed command. Never committed or used at app boot.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Cloudinary upload support is intentionally disabled until these are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Kept for the current public email-handoff contact form.
CONTACT_EMAIL=hello@picvisual.example
