  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "6.7.0",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.12.5",
    "jose": "^6.2.10",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prisma": "6.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  },
